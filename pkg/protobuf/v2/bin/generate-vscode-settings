#!/usr/bin/env bash
set -euo pipefail

# This script generates a VSCode settings file for the DrBlury.protobuf-vsc
# extension. It derives the include paths from the --proto_path= options in one
# or more protoc argument files, and has the extension format .proto files with
# the project's clang-format.

if [[ "$#" -lt 2 ]]; then
    echo "usage: $0 <output-file> <arg-file>..."
    exit 1
fi

output_file="${1}"
arg_files=("${@:2}")

mkdir -p "$(dirname "${output_file}")"

if ! hash jq 2>/dev/null; then
    echo "no jq binary is installed in the executable path, protobuf-vsc settings will not be generated"
    echo "{}" > "${output_file}"
    exit 0
fi

includes=()
for option in $(cat "${arg_files[@]}"); do
    if [[ "${option}" == --proto_path=* ]]; then
        includes+=("${option#--proto_path=}")
    fi
done

# clang_format is the absolute path of the script that runs the project's
# clang-format, which the extension runs to format .proto files the same way
# that "make precommit" does.
clang_format="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/exec-clang-format"

# Duplicates are dropped, keeping the first occurrence, since the argument files
# share most of their include paths.
#
# ${includes[@]+"${includes[@]}"} expands to nothing when the array is empty,
# whereas "${includes[@]}" is an unbound variable error in bash 3.2, the version
# that ships with macOS.
jq --null-input --arg clang_format "${clang_format}" --args '{
    "protobuf.includes": ($ARGS.positional | reduce .[] as $p ([]; if index([$p]) then . else . + [$p] end)),
    "protobuf.protoc.compileOnSave": false,
    "protobuf.clangFormat.enabled": true,
    "protobuf.clangFormat.path": $clang_format,
    "protobuf.clangFormat.style": "file",
    "protobuf.clangFormat.fallbackStyle": "Google"
}' ${includes[@]+"${includes[@]}"} > "${output_file}"

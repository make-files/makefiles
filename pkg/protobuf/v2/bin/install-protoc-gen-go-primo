#!/usr/bin/env bash
set -euo pipefail

required_plugins=(
  "github.com/dogmatiq/primo/cmd/protoc-gen-go-primo"
)

tool_list="$(go tool)"

is_tool_installed() {
  local tool="$1"
  [[ "$tool_list" == *"($tool)"* ]]
}

export GOBIN="$1"
mkdir -p "$GOBIN"

for plugin in "${required_plugins[@]}"; do
  if is_tool_installed "$plugin"; then
    echo "found $plugin in go.mod"
  else
    echo "did not find $plugin in go.mod, defaulting to latest version"
    go get -tool "$plugin"
  fi

  # Install the required plugin into the specified GOBIN directory. The
  # versions of the installed plugin will match the version specified in
  # go.mod.
  go install "$plugin"
done

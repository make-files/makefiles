#!/usr/bin/env bash
set -euo pipefail

# This script lists this package and its dependencies that declare the import
# path of their .proto files in package.json:
#
#   "makefiles.dev": { "protobuf": { "importPath": "github.com/foo/bar" } }
#
# Each line has four tab-separated fields: "self" or "dependency", the import
# path, the npm name and the real path of the package's directory.
#
# Dependencies are found in node_modules, so Yarn PnP is not supported. It must
# be run in the project root with node on the PATH, for example via $(JS_EXEC).

exec node -e '
    const fs = require("fs");
    const path = require("path");

    function print(kind, dir) {
        let pkg;

        try {
            pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
        } catch {
            return;
        }

        const importPath = pkg["makefiles.dev"]?.protobuf?.importPath;

        if (importPath) {
            console.log([kind, importPath, pkg.name ?? "", fs.realpathSync(dir)].join("\t"));
        }
    }

    function entries(dir) {
        try {
            return fs.readdirSync(dir).filter((name) => !name.startsWith(".")).sort();
        } catch {
            return [];
        }
    }

    print("self", ".");

    for (const name of entries("node_modules")) {
        const dir = path.join("node_modules", name);

        if (name.startsWith("@")) {
            for (const scoped of entries(dir)) {
                print("dependency", path.join(dir, scoped));
            }
        } else {
            print("dependency", dir);
        }
    }
'

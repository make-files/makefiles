#!/usr/bin/env bash
set -euo pipefail

# Usage: require-go-tools <package>...
#
# Adds a "tool" directive to go.mod for each <package> that does not already
# have one, at the latest version. The tools are run using "go tool", at the
# versions in go.mod.

tool_list="$(go tool)"

for package in "$@"; do
    # Depending on the Go version, "go tool" lists each tool either as its
    # package path, or as its name followed by its package path in parentheses.
    if grep -qxF "$package" <<< "$tool_list" || [[ "$tool_list" == *"($package)"* ]]; then
        echo "found $package in go.mod"
        continue
    fi

    echo "did not find $package in go.mod, defaulting to latest version"

    # The go command refuses to update go.mod if it has changed since it was
    # read, which happens when make runs this script for several tools at once,
    # in which case it is safe to try again.
    for attempt in 1 2 3 4 5; do
        if output="$(go get -tool "$package" 2>&1)"; then
            [[ -z "$output" ]] || echo "$output"
            break
        fi

        if [[ "$output" != *"existing contents have changed since last read"* || $attempt == 5 ]]; then
            >&2 echo "$output"
            exit 1
        fi

        sleep 1
    done
done

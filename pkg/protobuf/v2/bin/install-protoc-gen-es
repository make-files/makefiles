#!/usr/bin/env bash
set -euo pipefail

# Writes a wrapper script that runs the project's locally installed
# protoc-gen-es plugin using the package manager's "exec" command, so that it
# works regardless of how the package manager links dependencies.
#
# The @bufbuild/protoc-gen-es package must be a dependency of the project.

plugin_path="$1"
js_exec="$2"

mkdir -p "$(dirname "$plugin_path")"

cat <<EOS > "$plugin_path"
#!/usr/bin/env bash
set -euo pipefail
exec $js_exec protoc-gen-es "\${@}"
EOS

chmod +x "$plugin_path"

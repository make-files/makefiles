#!/usr/bin/env bash
set -euo pipefail

# Bail if no files are specified.
if [[ $# -eq 0 ]]; then
    exit 0
fi

# Limit files to those tracked by Git.
files=$(git ls-files "$@")

# Bail if none of the specified files are tracked by Git.
if [[ -z "$files" ]]; then
    exit 0
fi

for file in "$files"; do
    # This diff command exits with a non-zero exit code if all changes to $file
    # are version comments. Therefore, if the exit code is 0, there are more
    # substantial changes.
    #
    # We use "X" as the new/old indicator to make it easier to ignore the
    # +++/--- lines in the diff header; we simply remove any lines that don't
    # begin with X.
    #
    # The --unified=0 flag removes any context lines, such that all lines are
    # either part of the diff header, a location indicator (@@ syntax), or an
    # addition/removal.
    #
    # Finally, we look for the presence of any additions/removals that are not a
    # version comment.
    #
    # We store the diff lines in a variable rather than piping directly to avoid
    # SIGPIPE issues; --quiet causes egrep to exit early, which can SIGPIPE the
    # upstream process and produce a non-zero pipeline status under pipefail.
    diff=$(git diff \
        --text \
        --unified=0 \
        --output-indicator-new='X' \
        --output-indicator-old='X' \
        -- "$file")

    # Skip files with no additions or removals.
    if ! diff=$(egrep '^X' <<< "$diff"); then
        continue
    fi

    # Revert if all additions/removals are version comments.
    #
    # The first pattern matches the "versions" comment block written by the Go
    # plugins, such as "//   protoc-gen-go v1.36.0". The second matches the
    # header written by the protobuf-es plugins, such as "// @generated by
    # protoc-gen-es v2.0.0 with parameter "target=ts"".
    if ! egrep --quiet --invert-match \
        -e '^X//\s+(-\s+)?protoc(-[a-z-]+)?\s+v[A-Za-z0-9.-]+$' \
        -e '^X//\s+@generated by protoc-gen-[a-z-]+\s+v[A-Za-z0-9.-]+( with parameter ".*")?$' \
        <<< "$diff"; then
        git restore -- "$file"
    fi
done
